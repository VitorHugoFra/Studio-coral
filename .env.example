# ─────────────────────────────────────────────────────────────
#  Studio Coral — Plataforma de Disparos (Etapa 1)
#  Copie este arquivo para .env e ajuste os valores.
# ─────────────────────────────────────────────────────────────

PORT=3000

# URL pública da plataforma. É usada nos links rastreáveis enviados aos
# clientes do restaurante (/r/xxxx). Em produção, use o domínio real (https).
PUBLIC_URL=http://localhost:3000

# ── Banco de dados ───────────────────────────────────────────
# Vazio: usa o PGlite (PostgreSQL embutido) em data/pgdata — bom para desenvolver.
# Produção: endereço do PostgreSQL, ex.: postgres://usuario:senha@host:5432/studio_coral
# Com SSL, prefira sslmode=verify-full: o driver pg avisa (SECURITY WARNING) ao receber require, prefer ou verify-ca.
# Use a conexão direta (ou o pooler em modo sessão, não o de transação, como a porta 6543 do Supabase): o servidor
# trava o banco para garantir uma instância só, e a trava precisa de uma conexão que dure.
DATABASE_URL=
# Conexões simultâneas com o PostgreSQL
DATABASE_POOL_MAX=10

# Acesso ao painel
ADMIN_NAME=Equipe Studio Coral
ADMIN_EMAIL=admin@studiocoral.com.br
ADMIN_PASSWORD=coral123
SESSION_SECRET=troque-esta-chave-por-uma-frase-longa-e-aleatoria

# ── E-mail (convites e "esqueci minha senha") ────────────────
#  none → sem serviço de e-mail: os links aparecem na tela Acessos para copiar e mandar
# Para ligar um serviço, crie um provedor em src/mail (contrato MailProvider) e use a chave dele aqui.
MAIL_PROVIDER=none

# ── Provedor de mensagens (injeção de dependência) ───────────
#  simulator       → modo demonstração, nada sai do servidor
#  wppconnect      → WhatsApp Web via WPPConnect (gratuito, leitura de QR Code)
#  whatsapp-cloud  → API Oficial do WhatsApp (Meta Cloud API, paga por conversa)
# O provedor também pode ser trocado em tempo real na tela "Conexão".
MESSAGING_PROVIDER=simulator

# ── WPPConnect ───────────────────────────────────────────────
WPP_SESSION=studio-coral
WPP_HEADLESS=true
# Simula "digitando..." antes de cada envio (reduz risco de bloqueio)
WPP_SIMULATE_TYPING=true

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v21.0
# Token que você define no painel da Meta para validar o webhook
WA_CLOUD_VERIFY_TOKEN=coral-webhook
# App Secret (opcional) para validar a assinatura X-Hub-Signature-256
WA_CLOUD_APP_SECRET=
