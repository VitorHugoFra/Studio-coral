{
  "name": "studio-coral-disparos",
  "version": "0.1.0",
  "private": true,
  "description": "Studio Coral — Etapa 1: plataforma de disparo de mensagens de marketing personalizadas para restaurantes (protótipo funcional).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js --reset",
    "db:import-json": "node scripts/importar-json.js",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.js\" && npm run test:pg",
    "test:pg": "node --env-file=test/pg.env --test --test-concurrency=4 \"test/http/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "alpinejs": "^3.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "8.23.1"
  },
  "optionalDependencies": {
    "@wppconnect-team/wppconnect": "^2.3.5"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.11"
  }
}
